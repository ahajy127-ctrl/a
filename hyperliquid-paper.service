[Unit]
Description=Hyperliquid Portfolio v4 - paper trader
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hyperliquid
Environment=PAPER_CAPITAL=1000
Environment=DASH_PORT=8080
ExecStart=/usr/bin/python3 v2/paper.py --loop
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
