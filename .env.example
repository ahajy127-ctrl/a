# ================================================================
# تنظیمات ربات نوبیتکس نسخه ۲۵ (Nobitex Bot v25 Environment Config)
# ================================================================
# نکته: بعد از ویرایش این فایل، نام آن را به .env تغییر دهید یا با اسکریپت نصب نصب کنید.

# ۱. توکن API نوبیتکس (از بخش کلیدهای API در حساب کاربری نوبیتکس دریافت کنید)
# NOBITEX_TOKEN=a1b2c3d4e5f6g7h8...

# ۲. اطلاعات ربات تلگرام (برای ارسال سیگنال‌ها و هشدارها)
# TG_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# TG_CHAT=12345678

# ۳. رمز عبور ورود به داشبورد وب (حداقل ۴ کاراکتر - امنیت سرور شما را تامین می‌کند)
DASH_PASS=admin1234

# ۴. حالت پیش‌فرض اجرای ربات (paper = فقط مجازی ۱۰۰ دلاری / live = مجازی + واقعی روی نوبیتکس)
# توصیه می‌شود هفته اول حتماً روی paper باشد.
MODE=paper

# ۵. آدرس API (برای محیط واقعی تغییر ندهید)
NOBITEX_API_BASE=https://apiv2.nobitex.ir

# ۶. تنظیمات اختیاری پروکسی تلگرام (در سرورهای خارج از ایران نیاز نیست)
# TG_PROXY=http://127.0.0.1:1080
