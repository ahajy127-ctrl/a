# ================= Hyperliquid Final V1 =================
# Default is PAPER. Do not switch to live until the checklist is complete.
MODE=paper
# Live requires this exact value in the process environment; never persist it in .env.
# LIVE_CONFIRM=I_UNDERSTAND_LIVE_TRADING

# Hyperliquid Agent Wallet (NOT your master wallet private key)
HL_ACCOUNT_ADDRESS=
HL_AGENT_PRIVATE_KEY=
HL_TESTNET=true

# Dashboard
DASH_PASS=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD_MIN_12_CHARS

# Optional Telegram alerts
TG_TOKEN=
TG_CHAT=

# Safety
LIVE_REQUIRE_BACKSTOP=true
LIVE_MAX_LEVERAGE=5
LIVE_MAX_TOTAL_RISK=0.10
LIVE_DAILY_LOSS_LIMIT=0.05
LIVE_MAX_POSITIONS=3
LIVE_MAX_BOOK_SHARE=0.10
LIVE_MIN_ORDER_USD=10

# Runtime
SCAN_INTERVAL=300
POS_CHECK_INTERVAL=15
NO_AUTO_INSTALL=true

# Strategy / research risk
# Account risk per normal trade; adaptive quality can scale up, capped at 1.25%.
RISK_PER_TRADE=0.01
# Research defaults: 90-day train / 30-day unseen test

# V5 Capital OS entry brain (paper mode). Set 0 to use legacy V4 sizing/gating.
V5_BRAIN_ENABLED=1
