# ================================================================
# تنظیمات ربات هایپرلیکوئید v26 (Hyperliquid Bot Environment Config)
# ================================================================
# نکته: بعد از ویرایش، نام فایل را به .env تغییر دهید یا از
# اسکریپت setup_hyperliquid.py استفاده کنید که همه را خودکار تنظیم می‌کند.

# ۱. حالت اجرا: paper = فقط مجازی ۱۰۰ دلاری (پیشنهاد هفته اول) / live = لایو + مجازی
MODE=paper

# ۲. شبکه: true = آزمایشی (Testnet) / false = واقعی (Mainnet)
HL_TESTNET=false

# ۳. آدرس کیف پول اصلی (Master) شما — همان کیف پول Rabby که سرمایه را واریز می‌کند
# HL_ACCOUNT_ADDRESS=0xYourRabbyWalletAddress

# ۴. کلید خصوصی کیف پول Agent (ربات با این امضا می‌کند) — توسط setup_hyperliquid.py ساخته می‌شود
# HL_AGENT_PRIVATE_KEY=0x...

# ۵. اطلاعات ربات تلگرام (اختیاری - برای هشدارها و گزارش‌ها)
# TG_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# TG_CHAT=12345678

# ۶. رمز عبور ورود به داشبورد وب (حداقل ۴ کاراکتر)
DASH_PASS=admin1234

# ۷. استاپ‌لاس محافظ روی خود صرافی (پیشنهاد: true)
HL_USE_TRIGGER_SL=true

# ۸. تنظیمات اختیاری پروکسی تلگرام (در سرورهای خارج از ایران نیاز نیست)
# TG_PROXY=http://127.0.0.1:1080
